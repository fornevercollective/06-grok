# Copy to `.env` / `.env.local`. Base URL for uvspeed `web/` static tree (trailing slash optional).
# Example: serve uvspeed web with `python3 -m http.server 8080` from `uvspeed/web`, then:
# VITE_UVSPEED_WEB_BASE=http://127.0.0.1:8080/

VITE_UVSPEED_WEB_BASE=

# grok-notes-backend (YouTube captions). Defaults to http://localhost:3000 in app code if unset.
# VITE_BACKEND_URL=http://localhost:3000

# Google Maps API key for Tesla map
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
