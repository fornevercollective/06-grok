function resolvedBlockIdForLine(line, lineIndex) {
  const fromText = extractBlockRefFromLine(line);
  if (fromText) return fromText;
  const manual = STATE.gutterLineToBlock[String(lineIndex)];
  if (manual && blockExists(manual)) return manual;
  const fromNode = blockIdByLinkedLine(lineIndex);
  if (fromNode) return fromNode;
  return null;
}

function blockExists(id) {
  return STATE.blocks.some(b => b.id === id);
}

function extractBlockRefFromLine(line) {
  let m = line.match(/\b(b-\d+)\b/i);
  if (m && blockExists(m[1])) return m[1];
  m = line.match(/@(?:block:)?(b-\d+)/i);
  if (m && blockExists(m[1])) return m[1];
  return null;
}

function blockIdByLinkedLine(lineIndex) {
  const b = STATE.blocks.find(b => b.linkedLineIndex === lineIndex);
  return b ? b.id : null;
}

function assignBlockToCodeLine(block, lineIndex) {
  STATE.blocks.forEach(b => {
    if (b.id !== block.id && b.linkedLineIndex === lineIndex) b.linkedLineIndex = null;
  });
  block.linkedLineIndex = lineIndex;
  STATE.gutterLineToBlock[String(lineIndex)] = block.id;
}

function pruneGutterEntriesForBlockId(blockId) {
  Object.keys(STATE.gutterLineToBlock).forEach(k => {
    if (STATE.gutterLineToBlock[k] === blockId) delete STATE.gutterLineToBlock[k];
  });
}

function canvasYForLineIndex(lineIndex) {
  return snapToGrid(GRID_ORIGIN_Y + lineIndex * GRID_SIZE);
}

function findCanvasPosForLine(lineIndex, excludeBlockId = null) {
  const y = canvasYForLineIndex(lineIndex);
  const rowBlocks = STATE.blocks.filter(b =>
    b.id !== excludeBlockId && snapToGrid(b.y) === y
  );
  const col = rowBlocks.length;
  return {
    x: snapToGrid(GRID_ORIGIN_X + (col % LAYOUT_COLS) * CELL_W),
    y
  };
}

