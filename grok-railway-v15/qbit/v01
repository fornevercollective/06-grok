function drawTimeline() {
  const cv = document.getElementById('timeline-canvas');
  const ctx = cv.getContext('2d');
  const W = cv.width, H = cv.height;
  ctx.clearRect(0, 0, W, H);
  ctx.fillStyle = '#0a0c12';
  ctx.fillRect(0, 0, W, H);

  const orders = 61;
  for (let i = 0; i <= orders; i++) {
    const x = (i / orders) * W;
    ctx.strokeStyle = i % 10 === 0 ? (STATE.tlScale === 'freya' ? '#22d3ee' : '#58a6ff') : '#30363d';
    ctx.lineWidth = i % 10 === 0 ? 2 : 1;
    ctx.beginPath();
    ctx.moveTo(x, 20);
    ctx.lineTo(x, H - 20);
    ctx.stroke();
    if (i % 5 === 0) {
      ctx.fillStyle = STATE.tlScale === 'freya' ? '#22d3ee' : '#58a6ff';
      ctx.font = '9px IBM Plex Mono';
      ctx.fillText(STATE.tlScale === 'freya' ? '10^' + (i - 30) : i + 's', x + 4, 14);
    }
  }

  ctx.fillStyle = STATE.tlScale === 'freya' ? '#22d3ee' : '#58a6ff';
  ctx.font = 'bold 10px IBM Plex Mono';
  ctx.textAlign = 'center';
  ctx.fillText(STATE.tlScale === 'freya' ? 'FREYA UNITS LOG SCALE' : 'HISTORY TIMELINE SCALE', W / 2, H - 8);
  ctx.textAlign = 'left';
}

function createBlock(type, title = '', content = '', opts = {}) {
  const bt = BLOCK_TYPES[type] || BLOCK_TYPES.event;
  const id = 'b-' + STATE.nextId++;
  if (!STATE.versionCounter[type]) STATE.versionCounter[type] = 0;
  const version = ++STATE.versionCounter[type];
  let pos;
  if (opts.x != null && opts.y != null) {
    pos = { x: snapToGrid(opts.x), y: snapToGrid(opts.y) };
  } else if (opts.linkedLineIndex != null && opts.linkedLineIndex >= 0) {
    pos = findCanvasPosForLine(opts.linkedLineIndex);
  } else {
    pos = nextLogicalGridSlot();
  }
  const block = {
    id,
    type,
    title: title || bt.label,
    content: content || '',
    x: pos.x,
    y: pos.y,
    version,
    linkedLineIndex: opts.linkedLineIndex != null && opts.linkedLineIndex >= 0 ? opts.linkedLineIndex : null,
    clusterId: null,
    groupId: null
  };
  if (block.linkedLineIndex != null) assignBlockToCodeLine(block, block.linkedLineIndex);
  STATE.blocks.push(block);
  renderBlock(block);
  updateStats();
  return block;
}

function renderBlock(block) {
  const bt = BLOCK_TYPES[block.type] || BLOCK_TYPES.event;
  const el = document.createElement('div');
  el.className = 'block';
  el.id = block.id;
  el.style.left = block.x + 'px';
  el.style.top = block.y + 'px';
  el.style.borderLeft = `4px solid ${bt.color}`;
  el.innerHTML = `
    <div class="connector in" data-id="${block.id}"></div>
    <div class="block-header">
      <span class="cli-prompt">${bt.cli}</span>
      <span class="prefix" style="color:${bt.color}">${bt.prefix}</span>
      <span style="font-weight:600">${bt.label}</span>
      <span style="flex:1"></span>
      <span class="block-version" title="Variation for this node type">v${block.version}</span>
      ${block.linkedLineIndex != null ? `<span class="block-line-pill" title="Linked to notes line ${block.linkedLineIndex + 1}">L${block.linkedLineIndex + 1}</span>` : ''}
      <span onclick="removeBlock('${block.id}');event.stopImmediatePropagation()" style="cursor:pointer;color:#8b949e">✕</span>
    </div>
    <div class="block-body" contenteditable="true" spellcheck="false">${block.title || ''}</div>
    <div class="connector out" data-id="${block.id}"></div>
  `;
  document.getElementById('orchestrator-panel').appendChild(el);

  const body = el.querySelector('.block-body');
  body.addEventListener('input', () => {
    block.title = body.innerText;
    syncNodeToNotes(block);
    drawConnections();
  });

  let offsetX, offsetY, isDragging = false, startY = 0;
  const startDrag = (clientX, clientY) => {
    isDragging = true;
    STATE.selectedBlock = block;
    offsetX = clientX - block.x;
    offsetY = clientY - block.y;
    startY = clientY;
    document.querySelectorAll('.block').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    el.style.zIndex = 100;
  };
  const moveDrag = (clientX, clientY) => {
    if (!isDragging || STATE.selectedBlock?.id !== block.id) return;
    let nx = clientX - offsetX;
    let ny = clientY - offsetY;
    if (gridLocked) {
      nx = snapToGrid(nx);
      ny = snapToGrid(ny);
    }
    block.x = nx;
    block.y = ny;
    el.style.left = block.x + 'px';
    el.style.top = block.y + 'px';
    drawConnections();
  };

  el.addEventListener('mousedown', e => {
    const t = e.target;
    if (t.closest && (t.closest('span[onclick]') || t.classList.contains('block-version'))) return;
    startDrag(e.clientX, e.clientY);
  });
  window.addEventListener('mousemove', e => { moveDrag(e.clientX, e.clientY); });
  window.addEventListener('mouseup', () => { 
    if (isDragging) reorderBlocksByPosition();
    isDragging = false; 
    STATE.selectedBlock = null; 
    el.style.zIndex = 10;
  });

  el.addEventListener('touchstart', e => {
    e.preventDefault();
    startDrag(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: false });
  window.addEventListener('touchmove', e => { if (isDragging) moveDrag(e.touches[0].clientX, e.touches[0].clientY); }, { passive: false });
  window.addEventListener('touchend', () => { 
    if (isDragging) reorderBlocksByPosition();
    isDragging = false; 
    STATE.selectedBlock = null; 
  });

  el.addEventListener('click', () => { STATE.selectedBlock = block; updateInspector(); });
}

function reorderBlocksByPosition() {
  STATE.blocks.sort((a, b) => a.y - b.y);
  STATE.blocks.forEach((block, idx) => {
    block.linkedLineIndex = idx;
    STATE.gutterLineToBlock[String(idx)] = block.id;
  });
  const ed = document.getElementById('editor');
  if (ed) {
    const lines = ed.innerText.split('\n');
    STATE.blocks.forEach((block, idx) => {
      if (idx < lines.length) lines[idx] = block.title;
    });
    ed.innerText = lines.join('\n');
    liveAnalyze(ed.innerText);
  }
  drawConnections();
  updateStats();
}

function removeBlock(id) {
  pruneGutterEntriesForBlockId(id);
  const el = document.getElementById(id);
  if (el) el.remove();
  STATE.blocks = STATE.blocks.filter(b => b.id !== id);
  STATE.connections = STATE.connections.filter(c => c.from !== id && c.to !== id);
  drawConnections();
  updateStats();
  const ed = document.getElementById('editor');
  if (ed) liveAnalyze(ed.innerText || '');
}

function catmullRomSpline(points, tension = catmullTension) {
  if (points.length < 4) return points;
  const result = [];
  for (let i = 1; i < points.length - 2; i++) {
    const p0 = points[i - 1];
    const p1 = points[i];
    const p2 = points[i + 1];
    const p3 = points[i + 2];
    for (let t = 0; t <= 1; t += 0.08) {
      const t2 = t * t;
      const t3 = t2 * t;
      const tt = (1 - tension) * 0.5;
      const x = tt * ((-p0.x + 3*p1.x - 3*p2.x + p3.x) * t3 + (2*p0.x - 5*p1.x + 4*p2.x - p3.x) * t2 + (-p0.x + p2.x) * t + 2*p1.x);
      const y = tt * ((-p0.y + 3*p1.y - 3*p2.y + p3.y) * t3 + (2*p0.y - 5*p1.y + 4*p2.y - p3.y) * t2 + (-p0.y + p2.y) * t + 2*p1.y);
      result.push({x, y});
    }
  }
  return result;
}

function drawConnections() {
  const svg = document.getElementById('block-svg');
  svg.innerHTML = '';
  STATE.connections.forEach(conn => {
    const fromEl = document.getElementById(conn.from);
    const toEl = document.getElementById(conn.to);
    if (!fromEl || !toEl) return;
    const panel = document.getElementById('orchestrator-panel').getBoundingClientRect();
    const f = fromEl.getBoundingClientRect();
    const t = toEl.getBoundingClientRect();
    const x1 = f.right - panel.left;
    const y1 = f.top + f.height / 2 - panel.top;
    const x2 = t.left - panel.left;
    const y2 = t.top + t.height / 2 - panel.top;

    const dx = x2 - x1;
    const dy = y2 - y1;
    let pathD = '';

    if (Math.abs(dx) > Math.abs(dy) * 1.2) {
      const offset = 70;
      const elbowY = y1 + (dy * 0.4);
      pathD = `M ${x1} ${y1} L ${x1 + offset} ${y1} L ${x1 + offset} ${elbowY} L ${x2 - offset} ${elbowY} L ${x2 - offset} ${y2} L ${x2} ${y2}`;
    } else {
      const points = [
        {x: x1 - 50, y: y1},
        {x: x1, y: y1},
        {x: x2, y: y2},
        {x: x2 + 50, y: y2}
      ];
      const splinePoints = catmullRomSpline(points, catmullTension);
      pathD = `M ${x1} ${y1}`;
      for (let i = 1; i < splinePoints.length; i++) {
        pathD += ` L ${splinePoints[i].x} ${splinePoints[i].y}`;
      }
    }

    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', pathD);
    path.setAttribute('stroke', '#58a6ff');
    path.setAttribute('stroke-width', '3');
    path.setAttribute('fill', 'none');
    svg.appendChild(path);
  });
}

window.setTension = function(t) {
  catmullTension = t;
  document.getElementById('status').textContent = `Nuke keying • tension ${t}`;
  drawConnections();
