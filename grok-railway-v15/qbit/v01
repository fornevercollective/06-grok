function updateInspector() {
  const block = STATE.selectedBlock;
  const insp = document.getElementById('insp-content');
  if (!block) {
    insp.innerHTML = '<div style="color:#8b949e;font-size:12px;">select a keying node</div>';
    return;
  }
  const bt = BLOCK_TYPES[block.type] || BLOCK_TYPES.event;
  insp.innerHTML = `
