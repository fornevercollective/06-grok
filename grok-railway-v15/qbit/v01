<script>
// ====================== QBITOS codec v3.4 • Auto-Routing Connections ======================
let currentMode = 'notes';
let stenoActive = false;
let currentContent = '';
let voiceActive = false;
let gridLocked = true;
let timelineCollapsed = false;
let liveAnalysisCollapsed = false;
let rightDrawerCollapsed = false;
let currentCliMode = 'agent';
let catmullTension = 0.5;

let STATE = {
  blocks: [],
  connections: [],
  groups: [],
  selectedBlock: null,
  nextId: 1,
  tlScale: 'freya',
  versionCounter: {},
  gutterLineToBlock: {},
  gutterExpanded: new Set(),
  lastCaretLineIndex: 0,
  clusters: {}
};

const GRID_SIZE = 20;
const LAYOUT_COLS = 6;
const CELL_W = 240;
const CELL_H = 140;
const GRID_ORIGIN_X = 100;
const GRID_ORIGIN_Y = 100;

function snapToGrid(v) { return Math.round(v / GRID_SIZE) * GRID_SIZE; }

function nextLogicalGridSlot() {
  const idx = STATE.blocks.length;
  const col = idx % LAYOUT_COLS;
  const row = Math.floor(idx / LAYOUT_COLS);
  return {
    x: snapToGrid(GRID_ORIGIN_X + col * CELL_W),
    y: snapToGrid(GRID_ORIGIN_Y + row * CELL_H)
  };
}

const BLOCK_TYPES = {
  source:  { prefix: 'Read',   color: '#ef4444', label: 'PLATE / READ',   cli: '>' },
  chapter: { prefix: 'Group',  color: '#3fb950', label: 'BACKDROP / SECTION',  cli: '#' },
  entity:  { prefix: 'Grade',  color: '#f0883e', label: 'DESPILL / GRADE',   cli: '@' },
  event:   { prefix: 'Merge',  color: '#58a6ff', label: 'MERGE (B-spine)',    cli: '!' },
  relation:{ prefix: 'Dot',    color: '#d2a8ff', label: 'DOT / CLEAN', cli: '→' },
  analysis:{ prefix: 'Key',    color: '#79c0ff', label: 'IBK / KEYLIGHT', cli: '?' }
};

function classifyLine(line) {
  if (!line || !line.trim()) return {sym:'0', gate:'I', color:'#8b949e'};
  const l = line.toLowerCase().trim();
  if (l.includes('read') || l.includes('plate')) return {sym:'▶', gate:'R', color:'#ef4444'};
  if (l.includes('merge') || l.includes('over')) return {sym:'↓', gate:'M', color:'#58a6ff'};
  if (l.includes('grade') || l.includes('despill')) return {sym:'●', gate:'G', color:'#f0883e'};
  if (l.includes('ibk') || l.includes('keylight') || l.includes('primatte')) return {sym:'✂', gate:'K', color:'#79c0ff'};
  if (l.includes('backdrop') || l.includes('group') || l.includes('section')) return {sym:'□', gate:'B', color:'#3fb950'};
  return {sym:'0', gate:'I', color:'#8b949e'};
}

window.liveAnalyze = function(text) {
  currentContent = text;
  const lines = text.split('\n');
  let gutterHTML = '';
  let summary = `<b>${lines.length} lines • Nuke Keying Gutter</b><br>`;

  lines.forEach((line, i) => {
    const c = classifyLine(line);
    const expanded = STATE.gutterExpanded.has(i);
    const linkedId = resolvedBlockIdForLine(line, i);
    const linkBtn = linkedId
      ? `<button type="button" class="gutter-block-link" onclick="focusBlock('${linkedId}');event.stopImmediatePropagation()" data-block-id="${linkedId}" title="Jump to node ${linkedId}">↗ b-${linkedId.split('-')[1]}</button>`
      : '';
    gutterHTML += `
      <div class="gutter-row ${expanded ? 'expanded' : ''}" data-line="${i}" style="border-left-color:${c.color}">
        <div class="gutter-row-main">
          <button type="button" class="gutter-expand" data-gutter-line="${i}" aria-expanded="${expanded}" title="Line ${i + 1}: expand">${expanded ? '−' : '+'}</button>
          <span class="gutter-sym" style="color:${c.color}">${c.sym}</span>
          <span class="gutter-gate" style="color:${c.color}">${c.gate}</span>
          ${linkBtn}
        </div>
      </div>`;
    if (i < 12) summary += `<span style="color:${c.color}">${c.sym}</span> ${line.substring(0, 42)}${line.length>42?'…':''}<br>`;
  });

  document.getElementById('gutter').innerHTML = gutterHTML;
  document.getElementById('analysis').innerHTML = summary + '<br><small>Auto-routing active: click "Auto-Route All" for smart Nuke-style elbows + splines. Drag blocks to reorder. Grouping supported.</small>';
};

function resolvedBlockIdForLine(line, lineIndex) {
  const fromText = extractBlockRefFromLine(line);
  if (fromText) return fromText;
  const manual = STATE.gutterLineToBlock[String(lineIndex)];
  if (manual && blockExists(manual)) return manual;
  const fromNode = blockIdByLinkedLine(lineIndex);
  if (fromNode) return fromNode;
  return null;
}

function blockExists(id) {
  return STATE.blocks.some(b => b.id === id);
}

function extractBlockRefFromLine(line) {
  let m = line.match(/\b(b-\d+)\b/i);
  if (m && blockExists(m[1])) return m[1];
  m = line.match(/@(?:block:)?(b-\d+)/i);
  if (m && blockExists(m[1])) return m[1];
  return null;
}

function blockIdByLinkedLine(lineIndex) {
  const b = STATE.blocks.find(b => b.linkedLineIndex === lineIndex);
  return b ? b.id : null;
}

function assignBlockToCodeLine(block, lineIndex) {
  STATE.blocks.forEach(b => {
    if (b.id !== block.id && b.linkedLineIndex === lineIndex) b.linkedLineIndex = null;
  });
  block.linkedLineIndex = lineIndex;
  STATE.gutterLineToBlock[String(lineIndex)] = block.id;
}

function pruneGutterEntriesForBlockId(blockId) {
  Object.keys(STATE.gutterLineToBlock).forEach(k => {
    if (STATE.gutterLineToBlock[k] === blockId) delete STATE.gutterLineToBlock[k];
  });
}

function canvasYForLineIndex(lineIndex) {
  return snapToGrid(GRID_ORIGIN_Y + lineIndex * GRID_SIZE);
}

function findCanvasPosForLine(lineIndex, excludeBlockId = null) {
  const y = canvasYForLineIndex(lineIndex);
  const rowBlocks = STATE.blocks.filter(b =>
    b.id !== excludeBlockId && snapToGrid(b.y) === y
  );
  const col = rowBlocks.length;
  return {
    x: snapToGrid(GRID_ORIGIN_X + (col % LAYOUT_COLS) * CELL_W),
    y
  };
}

window.toggleMode = function() {
  currentMode = currentMode === 'notes' ? 'orchestrator' : 'notes';
  document.getElementById('notes-panel').style.display = currentMode === 'notes' ? 'flex' : 'none';
  document.getElementById('orchestrator-panel').style.display = currentMode === 'orchestrator' ? 'flex' : 'none';
  if (currentMode === 'orchestrator') drawConnections();
};

window.toggleScale = function() {
  STATE.tlScale = STATE.tlScale === 'freya' ? 'history' : 'freya';
  drawTimeline();
};

window.toggleGridLock = function() {
  gridLocked = !gridLocked;
  document.querySelectorAll('#canvas-tools button').forEach(b => {
    if (b.textContent.includes('grid')) b.style.color = gridLocked ? '#22d3ee' : '';
  });
};

window.toggleTimelineCollapse = function() {
  timelineCollapsed = !timelineCollapsed;
  const strip = document.getElementById('timeline-strip');
  const btn = document.getElementById('tl-collapse-btn');
  strip.classList.toggle('collapsed', timelineCollapsed);
  btn.textContent = timelineCollapsed ? '▶ expand' : '▼ collapse timeline';
  drawTimeline();
};

window.toggleLiveAnalysis = function() {
  liveAnalysisCollapsed = !liveAnalysisCollapsed;
  const panel = document.getElementById('live-analysis-panel');
  const toggle = document.getElementById('live-analysis-toggle');
  panel.classList.toggle('collapsed', liveAnalysisCollapsed);
  toggle.textContent = liveAnalysisCollapsed ? '▶' : '▼';
};

window.toggleRightDrawer = function() {
  rightDrawerCollapsed = !rightDrawerCollapsed;
  const drawer = document.getElementById('right-column-drawer');
  const btn = document.getElementById('right-drawer-collapse');
  drawer.classList.toggle('collapsed', rightDrawerCollapsed);
  btn.textContent = rightDrawerCollapsed ? '‹' : '›';
};

window.toggleSteno = function() {
  stenoActive = !stenoActive;
  document.getElementById('status').textContent = stenoActive ? 'stenoSTRIP on' : 'ready • grok-notes v3.4 • auto-routing active';
};

window.runStenoReplace = function() {
  const ed = document.getElementById('editor');
  ed.innerText = ed.innerText.replace(/\bthe\b/gi, 'ðə');
  liveAnalyze(ed.innerText);
};

window.exportQbit = function() {
  const t = document.getElementById('editor').innerText;
  const blob = new Blob([t], { type: 'text/plain;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'nuke-keying.qbit';
  a.click();
  URL.revokeObjectURL(a.href);
