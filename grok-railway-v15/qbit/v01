function clearBlocks() {
  STATE.blocks.forEach(b => { const el = document.getElementById(b.id); if (el) el.remove(); });
  STATE.blocks = [];
  STATE.connections = [];
  STATE.versionCounter = {};
  STATE.gutterLineToBlock = {};
  drawConnections();
  updateStats();
  const ed = document.getElementById('editor');
  if (ed) liveAnalyze(ed.innerText || '');
}

function getCaretLineIndex() {
  const ed = document.getElementById('editor');
  if (!ed) return 0;
  const sel = window.getSelection();
  if (!sel.rangeCount) return 0;
  const range = sel.getRangeAt(0).cloneRange();
  if (!ed.contains(range.commonAncestorContainer)) return 0;
  range.selectNodeContents(ed);
  range.setEnd(sel.anchorNode, sel.anchorOffset);
  const text = range.toString();
  return (text.match(/\n/g) || []).length;
}

function focusBlock(id) {
  const block = STATE.blocks.find(b => b.id === id);
  if (!block) return;
  setMode('orchestrator');
  STATE.selectedBlock = block;
  document.querySelectorAll('.block').forEach(b => b.classList.remove('selected'));
  const el = document.getElementById(id);
  if (el) el.classList.add('selected');
  updateInspector();
  requestAnimationFrame(() => {
