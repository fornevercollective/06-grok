    const merge = createBlock('event', 'Merge (B-spine)', 'Composite over BG', { x: 300, y: 660 });
    const output = createBlock('source', 'Viewer / Write', 'Final comp', { x: 300, y: 840 });

    STATE.connections.push({ from: plate.id, to: clean.id });
    STATE.connections.push({ from: clean.id, to: ibk.id });
    STATE.connections.push({ from: ibk.id, to: merge.id });
    STATE.connections.push({ from: despill.id, to: merge.id });
    STATE.connections.push({ from: merge.id, to: output.id });
  } else if (name === 'ibk-stack') {
    const plate = createBlock('source', 'Plate', 'Input');
    const ibk1 = createBlock('analysis', 'IBK Colour 1', 'Screen process');
    const ibk2 = createBlock('analysis', 'IBK 2', 'Stacked key');
    const edge = createBlock('entity', 'Edge Despill', 'Hair restore');
    const merge = createBlock('event', 'Merge', 'Over BG');
    STATE.connections.push({ from: plate.id, to: ibk1.id });
    STATE.connections.push({ from: ibk1.id, to: ibk2.id });
    STATE.connections.push({ from: ibk2.id, to: edge.id });
    STATE.connections.push({ from: edge.id, to: merge.id });
  }
  drawConnections();
  updateStats();
}

setTimeout(() => {
  loadPreset('nuke-keying');
  drawTimeline();
  drawConnections();
  const editor = document.getElementById('editor');
  editor.focus();
  liveAnalyze(editor.innerText || '');
