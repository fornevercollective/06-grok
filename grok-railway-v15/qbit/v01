  ed.focus();
  const cs = getComputedStyle(ed);
  const lh = parseFloat(cs.lineHeight) || 24.75;
  const pad = parseFloat(cs.paddingTop) || 16;
  const targetTop = pad + lineIndex * lh;
  wrap.scrollTop = Math.max(0, targetTop - wrap.clientHeight * 0.35);
}

