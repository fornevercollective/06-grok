    lines.forEach((line, i) => {
      const linkedId = resolvedBlockIdForLine(line, i);
      if (linkedId) {
        const block = STATE.blocks.find(b => b.id === linkedId);
        if (block) syncNotesToNode(i, line);
      }
    });
  });
}

