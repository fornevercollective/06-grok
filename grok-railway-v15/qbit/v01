}

window.openNotesAtLinkedLine = function() {
  const block = STATE.selectedBlock;
  if (!block || block.linkedLineIndex == null) return;
  setMode('notes');
  scrollNotesToLine(block.linkedLineIndex);
};

function scrollNotesToLine(lineIndex) {
  const ed = document.getElementById('editor');
  const wrap = document.getElementById('editor-wrap');
  if (!ed || !wrap) return;
  ed.focus();
  const cs = getComputedStyle(ed);
  const lh = parseFloat(cs.lineHeight) || 24.75;
  const pad = parseFloat(cs.paddingTop) || 16;
  const targetTop = pad + lineIndex * lh;
  wrap.scrollTop = Math.max(0, targetTop - wrap.clientHeight * 0.35);
}

window.linkCaretLineToSelectedBlock = function() {
  const block = STATE.selectedBlock;
  if (!block) return;
  const line = currentMode === 'notes' ? getCaretLineIndex() : STATE.lastCaretLineIndex;
  assignBlockToCodeLine(block, line);
  const pos = findCanvasPosForLine(line, block.id);
  block.x = pos.x;
  block.y = pos.y;
  const el = document.getElementById(block.id);
  if (el) {
    el.style.left = block.x + 'px';
    el.style.top = block.y + 'px';
  }
  drawConnections();
  const ed = document.getElementById('editor');
  if (ed) liveAnalyze(ed.innerText);
};

function syncNodeToNotes(block) {
  if (block.linkedLineIndex == null) return;
  const ed = document.getElementById('editor');
  if (!ed) return;
  const lines = ed.innerText.split('\n');
  if (block.linkedLineIndex >= lines.length) return;
  lines[block.linkedLineIndex] = block.title;
  ed.innerText = lines.join('\n');
  liveAnalyze(ed.innerText);
}

function syncNotesToNode(lineIndex, newTitle) {
  const block = STATE.blocks.find(b => b.linkedLineIndex === lineIndex);
  if (!block) return;
  block.title = newTitle;
  const el = document.getElementById(block.id);
  if (el) {
    const body = el.querySelector('.block-body');
    if (body) body.innerText = newTitle;
  }
  drawConnections();
}

function initBidirectionalSync() {
  const ed = document.getElementById('editor');
  if (!ed) return;
  ed.addEventListener('input', () => {
    const lines = ed.innerText.split('\n');
    lines.forEach((line, i) => {
      const linkedId = resolvedBlockIdForLine(line, i);
      if (linkedId) {
        const block = STATE.blocks.find(b => b.id === linkedId);
        if (block) syncNotesToNode(i, line);
      }
    });
  });
}

function createGroup() {
  const selectedBlocks = STATE.blocks.filter(b => b.selected || false); // TODO: implement multi-select later
  if (STATE.blocks.length === 0) return;
  const groupId = 'group-' + STATE.nextId++;
